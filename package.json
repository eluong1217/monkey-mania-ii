{
  "name": "monkey-mania-2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @monkey-mania-2/server\" \"npm run dev -w @monkey-mania-2/client\"",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "build": "npm run build --workspaces",
    "balance": "tsx scripts/balance.ts",
    "start": "npm run start -w @monkey-mania-2/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
